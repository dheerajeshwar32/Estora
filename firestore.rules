rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'dheerajeshwarnagula@gmail.com';
    }

    // Listings: anyone can read, only admins can write.
    // Exception: anyone can increment the views/saves counters.
    match /listings/{listingId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          // Allow anonymous counter updates ONLY for views and saves fields
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'saves'])
        );
    }

    // Inquiries: anyone can create (contact form), only admins can read/update/delete
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Property Submissions (List Your Property form): anyone can create, admins manage
    match /property_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Users: each user can read/write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}